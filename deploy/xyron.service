[Unit]
Description=XYRON Telegram Bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=xyron
Group=xyron
WorkingDirectory=/opt/xyron
EnvironmentFile=/etc/xyron/xyron.env
ExecStart=/opt/xyron/.venv/bin/python -m app
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/opt/xyron/data
ProtectHome=true
UMask=0077

[Install]
WantedBy=multi-user.target