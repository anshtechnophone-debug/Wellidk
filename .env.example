BOT_TOKEN=replace_me
OWNER_ID=123456789
# Numeric chat ID of the official XYRON channel (e.g. -1001234567890).
# XYRON must be an administrator in that channel to verify member status.
XYRON_COMMUNITY_CHAT_ID=
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELETHON_SESSION=
OWNER_ADMIN_REQUIRED=true
PROTECTED_USER_IDS=
DATABASE_URL=sqlite+aiosqlite:///./data/xyron.db
LOG_LEVEL=INFO
TIMEZONE=UTC
MAX_REMINDERS_PER_USER=20
REPORT_DESTINATION_ID=
AI_ENABLED=false
AI_PROVIDER=openai_compatible
AI_MODEL=z-ai/glm-5.3-flash
AI_FALLBACK_MODEL=inclusionai/ling-3.1-flash
AI_API_KEY=
# Optional: enables Smart GC image/video NSFW detection.
OPENAI_MODERATION_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_GLOBAL_EMERGENCY_STOP=true
AI_CONTEXT_MESSAGES=10
AI_CONTEXT_RETENTION_SECONDS=3600
AI_RESPONSE_COOLDOWN_SECONDS=60
AI_GROUP_REQUESTS_PER_HOUR=12
AI_USER_REQUESTS_PER_DAY=10
AI_DAILY_TOKEN_BUDGET=50000
AI_ACTIVITY_THRESHOLD=5
AI_ACTIVITY_WINDOW_SECONDS=120
# XYRON Music plugin (Songsx only; no YouTube/Jamendo integration)
MUSIC_ENABLED=false
MUSIC_API_ID=
MUSIC_API_HASH=
MUSIC_OWNER_ID=
MUSIC_SONGSX_BOT=Songsx_bot
MUSIC_CACHE_CHANNEL_ID=4363096287
MUSIC_CHANNEL=@xyronschannel
MUSIC_DATA_DIR=./data/music
# Existing data paths on the old music VPS; migration reads but never deletes these files.
MUSIC_LEGACY_ACCOUNTS_FILE=/opt/wellidkmusic/data/player_accounts.json
MUSIC_LEGACY_CACHE_INDEX=/opt/wellidkmusic/media/songsx_cache.json
